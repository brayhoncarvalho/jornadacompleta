# Dock Nexus — registry privado (acesso via VPN)
# A autenticação é feita via variável de ambiente NODE_AUTH_TOKEN (CI)
# ou via token configurado no ~/.npmrc pessoal (dev local).
#
# Pergunte ao time APE o token de acesso ao Nexus.
# Nunca commite o token aqui.
registry=https://nexus.tools.dock.tech/repository/npm-all/
//nexus.tools.dock.tech/repository/npm-internal/:_authToken=${NODE_AUTH_TOKEN}
